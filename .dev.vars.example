# 配備するときに、この3つを入力します。
# ここに書いた項目が、そのまま入力欄になります。

# LINE Developers →「チャネル基本設定」タブの下のほう（32文字くらい）
LINE_CHANNEL_SECRET=

# LINE Developers →「Messaging API設定」タブの一番下
#   →「チャネルアクセストークン（長期）」の発行ボタンで出る値（200文字くらい）
LINE_CHANNEL_ACCESS_TOKEN=

# platform.openai.com →「API keys」で発行するキー（sk- で始まる）
#   文章を書く・Webで調べる・画像を作る、のすべてにこのキー1つを使います
#   ※先に前払いのクレジット（最低5ドル）を買ってください。自動チャージはオフのままを推奨します
#   ※ChatGPT（Plus など）の月額プランとは別物です
OPENAI_API_KEY=
