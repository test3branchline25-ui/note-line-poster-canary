{
  "manifest_version": 3,
  "name": "note連携ツール",
  "version": "1.2.0",
  "description": "LINE で作った記事を note へ投稿します。接続先は設定画面で指定します。",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://note.com/*",
    "https://*.note.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "note連携ツール"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*.workers.dev/*"
  ]
}
